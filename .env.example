# Copy to .env and fill in for a phase-1 pipeline test.

PORT=3000

# Read back from MediaMTX inside the docker-compose network.
SOURCE_RTMP_URL=rtmp://mediamtx:1935/live

# Phase 1: single hardcoded destination to prove the relay end-to-end.
# e.g. a YouTube "stream now" rtmp://a.rtmp.youtube.com/live2/<key>
# or the Subsplash Broadcaster RTMP URL+key.
DEST_RTMP_URL=

# Auto-start the relay on backend boot (phase 1 convenience; real
# start/stop control arrives with the Destinations/Scheduler phases).
AUTO_START=false
