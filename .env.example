# Copy to .env before running `docker compose up`.

PORT=3000

# Read back from MediaMTX inside the docker-compose network.
SOURCE_RTMP_URL=rtmp://mediamtx:1935/live

# MediaMTX's control API (used for the dashboard's input-status/preview)
# rejects unauthenticated requests from anywhere but 127.0.0.1 inside its
# own container — this password is shared between the mediamtx service
# (via docker-compose.yml's MTX_AUTHINTERNALUSERS_1_PASS) and the backend.
# Must be set to the same value in both places automatically — just fill
# this in once.
MEDIAMTX_API_PASSWORD=

# Where destinations/schedules are persisted (SQLite). Matches the
# docker-compose volume mount — leave as-is unless you change that too.
DB_PATH=/app/data/cgbcstream.db

# Passphrase used to encrypt stream keys at rest. Set this to a long
# random value and keep it out of version control — losing it means
# re-entering all destination stream keys.
ENCRYPTION_KEY=

# OAuth client from a Google Cloud project with the YouTube Data API v3
# enabled (APIs & Services > Credentials > Create OAuth client ID > Web
# application). Add YOUTUBE_REDIRECT_URI as an authorized redirect URI on
# that client, e.g. http://<this-machine-ip>:3000/api/youtube/oauth/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback

# "Sign in with Google" for the app's own login (gates the whole
# UI/API — separate purpose from the YouTube channel connection above,
# so it's its own OAuth client credentials). You can reuse the SAME
# Google Cloud OAuth client as YOUTUBE_CLIENT_ID/SECRET above if you'd
# rather manage one client — just add GOOGLE_LOGIN_REDIRECT_URI as an
# additional authorized redirect URI on it. Required — the app fails
# closed (nobody can sign in) until these are set.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Only Google accounts on these Workspace domains may sign in
# (comma-separated, no spaces needed around commas).
ALLOWED_GOOGLE_DOMAINS=cedargroveleeds.org,cedargroveleedsmedia.org
