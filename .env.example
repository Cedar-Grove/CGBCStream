# Copy to .env before running `docker compose up`.

PORT=3000

# Read back from MediaMTX inside the docker-compose network.
SOURCE_RTMP_URL=rtmp://mediamtx:1935/live

# Where destinations/schedules are persisted (SQLite). Matches the
# docker-compose volume mount — leave as-is unless you change that too.
DB_PATH=/app/data/cgbcstream.db

# Passphrase used to encrypt stream keys at rest. Set this to a long
# random value and keep it out of version control — losing it means
# re-entering all destination stream keys.
ENCRYPTION_KEY=
